---
/** Landing-page heading block. Carries the page's single glitch and the scene sentinel. */
interface Props {
  title: string;
  lede?: string;
}

const { title, lede } = Astro.props;
---

<header class="intro" data-scene-sentinel>
  <h1 class="intro__title chroma glitch">{title}</h1>
  {lede && <p class="intro__lede">{lede}</p>}
  <slot />
</header>

<style>
  .intro {
    padding-block: clamp(var(--space-5), 14vh, 160px) var(--space-5);
    max-width: 60ch;
  }
  .intro__title {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-3);
  }
  .intro__lede {
    font-size: clamp(1.125rem, 1.6vw, 1.3rem);
    color: var(--ink);
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.9);
    margin: 0;
  }
</style>
