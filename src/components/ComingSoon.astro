---
import { SECTIONS } from "../data/profile";
import Landing from "../layouts/Landing.astro";

interface Props {
  href: string;
}

const section = SECTIONS.find((s) => s.href === Astro.props.href);
if (!section) throw new Error(`Unknown section ${Astro.props.href}`);
---

<Landing title={section.label} description={section.blurb} scene={section.scene}>
  <div class="wrap stub" data-scene-sentinel>
    <div class="panel stub__panel">
      <h1 class="chroma glitch">{section.label}</h1>
      <p>{section.blurb}</p>
      <p class="stub__note">This section is still being built. <a href="/">Back to the home page</a></p>
    </div>
  </div>
</Landing>

<style>
  .stub {
    min-height: calc(100svh - 160px);
    display: grid;
    align-items: end;
    padding-block: var(--space-6) var(--space-4);
  }
  .stub__panel { max-width: 560px; }
  .stub__note { color: var(--ink-dim); margin: 0; }
</style>
