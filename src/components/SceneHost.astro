---
import { SCENES } from "../scenes/registry";
import type { SceneId, SceneMode } from "../scenes/types";

interface Props {
  scene: SceneId;
  mode?: SceneMode;
  live?: boolean;
}

const { scene, mode = "full" } = Astro.props;
const live = (Astro.props.live ?? true) && scene in SCENES;
---

<div
  class="scene"
  data-scene={scene}
  data-mode={mode}
  data-live={live ? "" : undefined}
  aria-hidden="true"
  style={`--scene-bg: var(--scene-${scene})`}
>
  {live && <canvas class="scene__canvas" />}
  <div class="scene__veil"></div>
</div>

<script>
  // three.js loads only after first paint, never blocking LCP. Without WebGL the gradient stays.
  const host = document.querySelector<HTMLElement>(".scene[data-live]");
  function hasWebGL(): boolean {
    try {
      const c = document.createElement("canvas");
      return !!(c.getContext("webgl2") ?? c.getContext("webgl"));
    } catch {
      return false;
    }
  }
  if (host && hasWebGL()) {
    const go = () => void import("../scenes/boot").then((m) => m.boot(host)).catch(() => {});
    requestAnimationFrame(() => {
      if ("requestIdleCallback" in window) requestIdleCallback(go, { timeout: 2000 });
      else setTimeout(go, 300);
    });
  }
</script>

<style>
  .scene {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--scene-bg, var(--scene-home));
    view-transition-name: scene;
  }
  .scene__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .scene:global(.is-ready) .scene__canvas { opacity: 1; }
  .scene[data-mode="ambient"]:global(.is-ready) .scene__canvas { opacity: 0.55; }
  .scene__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(7, 5, 15, 0.72) 0%, rgba(7, 5, 15, 0.2) 42%, rgba(7, 5, 15, 0) 58%, rgba(7, 5, 15, 0.35) 100%),
      linear-gradient(0deg, rgba(7, 5, 15, 0.88) 0%, rgba(7, 5, 15, 0) 38%);
  }
  .scene[data-mode="ambient"] .scene__veil { background: rgba(7, 5, 15, 0.45); }
  @media (max-width: 860px) {
    .scene__veil {
      background: linear-gradient(0deg, rgba(7, 5, 15, 0.9) 0%, rgba(7, 5, 15, 0.45) 55%, rgba(7, 5, 15, 0.1) 100%);
    }
  }
</style>
