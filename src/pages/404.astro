---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist." scene="home" sceneLive={false}>
  <div class="lost wrap">
    <div class="skyline" aria-hidden="true">
      <span style="--h: 38%; --w: 7%"></span><span style="--h: 62%; --w: 5%"></span><span style="--h: 45%; --w: 9%"></span>
      <span style="--h: 80%; --w: 6%"></span><span style="--h: 30%; --w: 8%"></span><span style="--h: 55%; --w: 7%"></span>
      <span style="--h: 92%; --w: 4%" class="tower"></span><span style="--h: 50%; --w: 8%"></span><span style="--h: 35%; --w: 6%"></span>
      <span style="--h: 70%; --w: 7%"></span><span style="--h: 42%; --w: 9%"></span><span style="--h: 58%; --w: 6%"></span>
    </div>
    <div class="panel panel--solid lost__panel">
      <p class="sign" aria-hidden="true">404</p>
      <h1 class="chroma glitch">This street doesn't exist</h1>
      <p>The page you were looking for has moved, or never was. Try one of these instead:</p>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/stack">Tech stack</a></li>
        <li><a href="/knowledge">Knowledge base</a></li>
      </ul>
    </div>
  </div>
</Base>

<style>
  .lost {
    position: relative;
    min-height: calc(100svh - 160px);
    display: grid;
    align-items: center;
    padding-block: var(--space-6);
  }
  .skyline {
    position: fixed;
    inset: auto 0 0 0;
    height: 55vh;
    display: flex;
    align-items: flex-end;
    gap: 1.2%;
    padding-inline: 2%;
    z-index: -1;
    opacity: 0.85;
  }
  .skyline span {
    width: var(--w);
    height: var(--h);
    background:
      repeating-linear-gradient(0deg, transparent 0 14px, rgba(255, 179, 71, 0.18) 14px 18px),
      repeating-linear-gradient(90deg, #0a0812 0 10px, transparent 10px 16px),
      #0a0812;
    box-shadow: 0 -1px 0 rgba(63, 240, 255, 0.25);
  }
  .skyline .tower { box-shadow: 0 -1px 0 var(--cyan), 0 0 40px rgba(63, 240, 255, 0.25); }
  .lost__panel { max-width: 560px; }
  .sign {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(4rem, 14vw, 8rem);
    line-height: 1;
    margin: 0 0 var(--space-2);
    color: var(--pink);
    text-shadow: 0 0 12px rgba(255, 46, 136, 0.8), 0 0 40px rgba(255, 46, 136, 0.45);
    animation: hum 4s steps(1, end) infinite;
  }
  @keyframes hum {
    0%, 91%, 100% { opacity: 1; }
    92% { opacity: 0.35; }
    94% { opacity: 1; }
    96% { opacity: 0.6; }
  }
  .lost h1 { font-size: var(--step-2); }
  .lost ul { margin: 0; padding-left: 1.1em; }
</style>
