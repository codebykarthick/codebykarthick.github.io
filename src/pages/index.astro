---
import Landing from "../layouts/Landing.astro";
import { profile, SECTIONS } from "../data/profile";
---

<Landing scene="home">
  <div class="wrap home">
    <header class="hero" data-scene-sentinel>
      <h1 class="hero__title chroma glitch">{profile.name}</h1>
      <p class="hero__role">{profile.role}</p>
      <p class="hero__lede">
        This is my public reference for the tech I'm learning and using. Each technology has its own page, linked to the
        notes, projects and ideas that came out of it.
      </p>
    </header>

    <nav class="panel sections" aria-labelledby="sections-title">
      <h2 id="sections-title">Where to start</h2>
      <ul>
        {
          SECTIONS.map((s) => (
            <li>
              <a class="section-link" href={s.href}>
                <span class="section-link__title">{s.label}</span>
                <span class="section-link__desc">{s.blurb}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Landing>

<style>
  .home {
    min-height: calc(100svh - 160px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    gap: var(--space-6);
    align-items: end;
    padding-block: var(--space-6) var(--space-4);
  }
  .hero__title {
    font-size: var(--step-hero);
    line-height: 0.84;
    letter-spacing: -0.035em;
    margin: 0 0 var(--space-3);
  }
  .hero__role {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--step-2);
    color: var(--cyan);
    margin: 0 0 var(--space-4);
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.85);
  }
  .hero__lede {
    max-width: 38ch;
    font-size: clamp(1.125rem, 1.6vw, 1.3rem);
    color: var(--ink-dim);
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.85);
    margin: 0;
  }
  .sections h2 { font-size: 1.25rem; margin-bottom: var(--space-2); }
  .sections ul { list-style: none; margin: 0; padding: 0; }
  .sections li + li { border-top: 1px solid var(--rule); }
  .section-link {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-2) var(--space-3) 14px;
    margin-left: -14px;
    border-left: 2px solid transparent;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s, background-color 0.15s;
  }
  .section-link:hover,
  .section-link:focus-visible {
    border-left-color: var(--pink);
    background: rgba(255, 46, 136, 0.08);
  }
  .section-link__title {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.2;
    transition: color 0.15s;
  }
  .section-link:hover .section-link__title,
  .section-link:focus-visible .section-link__title { color: var(--pink); }
  .section-link__desc { font-size: 1rem; line-height: 1.45; color: var(--ink-dim); }

  @media (max-width: 860px) {
    .home {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--space-5);
      padding-top: 18vh;
    }
  }
</style>
